{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/customer-webview-app",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://staging-api.redtaxi.co.uk/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
